# 换行符策略
#
# 为什么必须显式声明：Windows 的 cmd 对 **LF-only 的 .bat 会解析异常**
# （带 goto/标签的批处理可能死循环或跳过整段），而 Linux 对 CRLF 的 .sh
# 会报 `bad interpreter: /bin/bash^M`。仓库里两者都要有，就必须由 git 统一。

*.bat   text eol=crlf
*.cmd   text eol=crlf
# PowerShell 脚本保持 CRLF（Windows PowerShell 5.1 读无 BOM 的 UTF-8 脚本时按 ANSI
# 代码页解码，内容必须是纯 ASCII；换行用 CRLF 与 Windows 习惯一致）
*.ps1   text eol=crlf

*.sh    text eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.cfg   text eol=lf
# 生成的 CSV 也钉 LF：否则同一份数据在 Windows/Linux 上产出的字节不同
*.csv   text eol=lf

# 二进制资源不做换行转换
*.jpg   binary
*.jpeg  binary
*.png   binary
*.pdf   binary
*.pt    binary
*.onnx  binary
