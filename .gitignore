# 环境
.venv/
__pycache__/
*.py[cod]
*.egg-info/
# 注意：下面这些一律用「前导斜杠」锚定到仓库根。
# 不锚定的话，形如 `data/` 的规则会匹配**任意层级**的同名目录 —— 曾经把
# `src/toddata/`（EP0 的 6D 位姿数据模块）整目录静默忽略掉，导致 Linux 侧
# `from tod.data.pose6d import ...` 报 ModuleNotFoundError，而本机因为可编辑安装
# 直接指向源目录，反而看不出问题。
/build/
/dist/

# ultralytics 用户配置目录的回退位置（只读 HOME / 沙箱下由 tod.compat 指向这里）
.cache/

# 数据与权重（体积大，不入库）；只忽略仓库根的 data/ 与 datasets/
/data/
/datasets/

# 数据集注册表的机器相关覆盖（路径/挂载点因机器而异，不入库）；
# 入库的是 configs/datasets.yaml，这里只放"这台服务器新硬盘在哪"
/configs/datasets.local.yaml
*.pt
*.onnx
*.engine
*.pth

# 实验结果：只保留 summary，权重与可视化另存
results/*
!results/.gitkeep

# ultralytics 的默认输出目录（project 写相对路径时会落到这里）
/runs/

# 测试临时产物
tests/.tmp/

# 编辑器
.vscode/
.idea/
