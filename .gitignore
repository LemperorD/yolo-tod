# 环境
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ultralytics 用户配置目录的回退位置（只读 HOME / 沙箱下由 tod.compat 指向这里）
.cache/

# 数据与权重（体积大，不入库）
data/
datasets/
*.pt
*.onnx
*.engine
*.pth

# 实验结果：只保留 summary，权重与可视化另存
results/*
!results/.gitkeep

# ultralytics 的默认输出目录（project 写相对路径时会落到这里）
runs/

# 测试临时产物
tests/.tmp/

# 编辑器
.vscode/
.idea/
