prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: todrt
Description: yolo-tod C++ inference runtime (backends selectable at build time)
Version: @PROJECT_VERSION@

Libs: -L${libdir} -ltodrt
Cflags: -I${includedir}
